APP_NAME=RankCare API
ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rankwatch
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0
JWT_ACCESS_SECRET=replace-with-a-secure-secret
JWT_ACCESS_EXPIRES_IN_DAYS=1
FRONTEND_URL=http://localhost:5173
SERP_API_KEY=

# Razorpay Configuration (Get keys from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

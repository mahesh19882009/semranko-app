APP_NAME=RankCare API
ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rankcare
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=dev-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN_DAYS=1
FRONTEND_URL=http://localhost:5173

# DataForSEO Configuration (Recommended for rank tracking)
# Get credentials from https://dataforseo.com/
# SERP_API_LOGIN=your_email@example.com
# SERP_API_KEY=your_api_key
# Note: If using SerpAPI instead, only set SERP_API_KEY and leave SERP_API_LOGIN empty

TRIAL_DAYS=10

# Razorpay Configuration - Leave empty for zero-cost dev mode (mock payments will be used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
